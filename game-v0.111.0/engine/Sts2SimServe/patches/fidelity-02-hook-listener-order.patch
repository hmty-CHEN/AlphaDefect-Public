--- a/src/Sts2Sim.Core/Hooks/Hook.cs
+++ b/src/Sts2Sim.Core/Hooks/Hook.cs
@@ -530,9 +530,24 @@ public static class Hook
     {
         if (combatState.IsOverOrEnding() && !combatState.IsStarting())
             yield break;
-        // Keep the simulator's existing run/combat composition here (deviation #31).
+        // 原版 Hook.IterateCombatHookListeners 就是 CombatState.IterateHookListeners：逐个生物先给能力，
+        // 玩家再接遗物、药水、充能球、各牌堆的牌。原来这里先给全部遗物、药水再给战斗里的监听者（偏离 #31），
+        // 同一时机的能力与遗物先后颠倒（如赤红披风掉血触发百年拼图抽牌要排在暖手套选牌之前）。
+        // 只给具体的 CombatState 换成原版顺序（集合不变）；整局层面另有的监听者（测试探针等，不是玩家的遗物、药水）照旧排在最前。
+        if (combatState is not CombatState concrete)
+        {
+            foreach (AbstractModel model in combatState.RunState.IterateHookListeners(combatState))
+                yield return model;
+            yield break;
+        }
+        List<AbstractModel> ordered = concrete.IterateHookListeners(includePlayerInventory: true).ToList();
+        var inCombat = new HashSet<AbstractModel>(ordered, ReferenceEqualityComparer.Instance);
+        List<AbstractModel> extra = combatState.RunState.IterateHookListeners(combatState)
+            .Where(model => !inCombat.Contains(model)).ToList();
         // Actual dispatch loops apply lifecycle eligibility; this helper preserves raw capture.
-        foreach (AbstractModel model in combatState.RunState.IterateHookListeners(combatState))
+        foreach (AbstractModel model in extra)
+            yield return model;
+        foreach (AbstractModel model in ordered)
             yield return model;
     }
 
